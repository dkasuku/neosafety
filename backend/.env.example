# ---- Database (PostgreSQL) ----
# The app runs on PostgreSQL. On Railway, reference the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Locally, use the Postgres service's DATABASE_PUBLIC_URL (the *.railway.internal
# host only resolves from inside Railway):
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
# Leaving DATABASE_URL unset falls back to a local SQLite file for offline dev.
# That fallback is refused when RAILWAY_ENVIRONMENT is set, so a missing
# DATABASE_URL can never silently serve an empty catalogue in production.

# ---- Flask ----
FLASK_SECRET=change-me-in-production

# ---- Admin ----
# There is no Flask-side admin login. The only admin panel is the Next.js app at
# /admin; it signs in with ADMIN_PASSWORD (set on the web service) and calls this
# API with the shared bearer token below. This value MUST match ADMIN_API_TOKEN
# on the web service.
ADMIN_API_TOKEN=change-me-to-a-long-random-string

# ---- Frontend origin(s) allowed to call the API ----
CORS_ORIGINS=http://localhost:3000

# ---- WhatsApp number orders are sent to ----
WHATSAPP_NUMBER=254707866446
