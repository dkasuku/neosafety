# ---- NEO Safety storefront + admin (Next.js) ----
# Copy this file to .env.local and fill in the placeholders.
#
# Generate the two tokens and a password with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Never reuse these example placeholders as real values, and never commit real
# ones. ADMIN_SESSION_TOKEN in particular is the whole admin session: anyone who
# knows it can set the `neo_admin` cookie and skip the login page entirely.

# URL of the Flask backend API. In production this must be the API's PUBLIC
# domain -- the browser calls it too, so *.railway.internal will not work.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public URL of the storefront (used for SEO/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Password to sign in at /admin/login. There is no username -- this is the
# entire login, so make it long.
ADMIN_PASSWORD=replace-me-with-a-strong-password

# Session cookie value set after a successful login (long random string)
ADMIN_SESSION_TOKEN=replace-me-with-a-random-token

# Shared token the admin uses to call the backend admin API.
# MUST match ADMIN_API_TOKEN in the backend's environment.
ADMIN_API_TOKEN=replace-me-with-a-random-token
